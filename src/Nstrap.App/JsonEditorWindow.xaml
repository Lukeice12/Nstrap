<Window x:Class="Nstrap.App.JsonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JSON editor · N strap" Width="850" Height="650" MinWidth="640" MinHeight="460" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
  <Grid Background="{StaticResource CanvasBrush}">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,20"><TextBlock Text="JSON editor" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Edit or import a flat JSON object. Replace profile enables every imported entry. Export includes enabled flags only; disabled entries stay in the profile until you replace it." Style="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
    </StackPanel>
    <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="16" VerticalContentAlignment="Top" AutomationProperties.Name="Flag JSON"/>
    <TextBlock x:Name="Feedback" Grid.Row="2" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,14"/>
    <DockPanel Grid.Row="3"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Cancel" IsCancel="True" Style="{StaticResource Quiet}" Margin="0,0,8,0"/><Button Content="Replace profile" Style="{StaticResource Primary}" Click="ReplaceClick"/></StackPanel>
      <StackPanel Orientation="Horizontal"><Button Content="Import file" Click="ImportClick" Margin="0,0,8,0"/><Button Content="Export file" Click="ExportClick" Margin="0,0,8,0"/><Button Content="Validate" Click="ValidateClick"/></StackPanel>
    </DockPanel>
  </Grid>
  </Grid>
</Window>
