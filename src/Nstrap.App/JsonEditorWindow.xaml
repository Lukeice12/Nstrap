<Window x:Class="Nstrap.App.JsonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JSON editor · N strap" Width="850" Height="650" MinWidth="640" MinHeight="460" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}" PreviewKeyDown="WindowPreviewKeyDown">
  <Grid Background="{StaticResource CanvasBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16"><TextBlock Text="JSON editor" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="Edit all profile flags, including disabled entries. Accepts a flag object or name/value records. Replace profile uses exactly the entries shown; export includes enabled flags only." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
    </StackPanel>
    <Border x:Name="FindBar" Grid.Row="1" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="110"/><ColumnDefinition Width="112"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Label Content="_Find" Target="{Binding ElementName=FindQuery}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Padding="0" Margin="0,0,10,0"/>
        <TextBox x:Name="FindQuery" Grid.Column="1" Padding="9,7" FontSize="13" VerticalContentAlignment="Center" AutomationProperties.Name="Find in JSON" ToolTip="Case-insensitive text search. Enter: next. Shift+Enter: previous."/>
        <TextBlock x:Name="MatchStatus" Grid.Column="2" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button x:Name="PreviousMatchButton" Content="&#xE70E;" FontFamily="Segoe MDL2 Assets" Width="32" Padding="0" Margin="0,0,4,0" Click="PreviousMatchClick" ToolTip="Previous match (Shift+Enter)" AutomationProperties.Name="Previous match"/>
          <Button x:Name="NextMatchButton" Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" Width="32" Padding="0" Margin="0,0,4,0" Click="NextMatchClick" ToolTip="Next match (Enter)" AutomationProperties.Name="Next match"/>
          <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="30" Padding="0" FontSize="12" Style="{StaticResource Quiet}" Click="CloseFindClick" ToolTip="Close find (Escape)" AutomationProperties.Name="Close find"/>
        </StackPanel>
      </Grid>
    </Border>
    <TextBox x:Name="Editor" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" IsInactiveSelectionHighlightEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="13" Padding="12" VerticalContentAlignment="Top" AutomationProperties.Name="Flag JSON"/>
    <TextBlock x:Name="Feedback" Grid.Row="3" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,12"/>
    <DockPanel Grid.Row="4"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Cancel" IsCancel="True" Style="{StaticResource Quiet}" Margin="0,0,8,0"/><Button Content="Replace profile" Style="{StaticResource Primary}" Click="ReplaceClick"/></StackPanel>
      <StackPanel Orientation="Horizontal"><Button Content="Import file" Click="ImportClick" Margin="0,0,8,0"/><Button Content="Export file" Click="ExportClick" Margin="0,0,8,0"/><Button Content="Validate" Click="ValidateClick"/></StackPanel>
    </DockPanel>
  </Grid>
  </Grid>
</Window>
