<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Nstrap</AssemblyName>
    <RootNamespace>Nstrap.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Nstrap.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nstrap.Core\Nstrap.Core.csproj" />
    <Resource Include="Assets\Nstrap.ico" />
    <Resource Include="Assets\NstrapLogo.png" />
  </ItemGroup>
</Project>
