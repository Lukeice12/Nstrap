<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Nstrap</AssemblyName>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <RootNamespace>Nstrap.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Nstrap.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="RuntimeMaps\ReviewedMap.json" LogicalName="Nstrap.RuntimeFlags.ReviewedMap.json" />
    <ProjectReference Include="..\Nstrap.Core\Nstrap.Core.csproj" />
    <Resource Include="Assets\Nstrap.ico" />
    <Resource Include="Assets\NstrapIcon.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" Link="Licenses\Nstrap.txt" LogicalName="Nstrap.Licenses.Nstrap.txt" />
    <EmbeddedResource Include="Licenses\DotNet-LICENSE.txt" LogicalName="Nstrap.Licenses.DotNet-LICENSE.txt" />
    <EmbeddedResource Include="Licenses\DotNet-THIRD-PARTY-NOTICES.txt" LogicalName="Nstrap.Licenses.DotNet-THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="Licenses\WindowsDesktop-LICENSE.txt" LogicalName="Nstrap.Licenses.WindowsDesktop-LICENSE.txt" />
    <EmbeddedResource Include="Licenses\Wpf-THIRD-PARTY-NOTICES.txt" LogicalName="Nstrap.Licenses.Wpf-THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
