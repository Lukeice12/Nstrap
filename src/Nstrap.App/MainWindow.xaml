<Window x:Class="Nstrap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DisplayName}" Width="1100" Height="760" MinWidth="920" MinHeight="640" Style="{StaticResource {x:Type Window}}"
        WindowStartupLocation="CenterScreen" AllowDrop="True">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="Navigation"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="NavChrome" Background="Transparent" CornerRadius="4" BorderBrush="Transparent" BorderThickness="1">
          <Grid>
            <Border x:Name="SelectionMark" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Visibility="Collapsed"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource NavHoverBrush}"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource NavSelectedBrush}"/><Setter TargetName="SelectionMark" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LicenseCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="232"/>
      <Setter Property="MinHeight" Value="74"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="PresetChoiceItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
      <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
    </Style>
    <Style x:Key="PresetExpander" TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton x:Name="HeaderSite" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                        Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                        Foreground="{TemplateBinding Foreground}" Background="Transparent" Padding="10,9" Cursor="Hand"
                        HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Width="12" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource NavHoverBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="ExpandedContent" Visibility="Collapsed" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  </Window.Resources>
  <Grid Background="{DynamicResource CanvasBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="12,20,12,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="12,0,8,24"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image Source="{DynamicResource AppIcon}" Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="N strap logo"/>
          <TextBlock Grid.Column="1" Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,16">
          <TextBox Text="{Binding SettingsSearch, UpdateSourceTrigger=PropertyChanged}" Padding="10,8,30,8" ToolTip="Search settings" AutomationProperties.Name="Search settings"/>
          <TextBlock Text="Search settings" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}" Margin="11,0,32,0" FontSize="12" VerticalAlignment="Center">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SettingsSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
          </TextBlock>
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" IsHitTestVisible="False"/>
        </Grid>
        <StackPanel Grid.Row="2">
          <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding HasSettingsSearch}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
          <RadioButton x:Name="HomeNav" Style="{StaticResource NavButton}" IsChecked="True" Tag="0" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" Width="29" VerticalAlignment="Center"/><TextBlock Text="Overview"/></StackPanel></RadioButton>
          <RadioButton x:Name="FlagsNav" Style="{StaticResource NavButton}" Tag="1" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="29" VerticalAlignment="Center"/><TextBlock Text="FastFlags"/></StackPanel></RadioButton>
          <RadioButton x:Name="PresetsNav" Style="{StaticResource NavButton}" Tag="2" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Width="29" VerticalAlignment="Center"/><TextBlock Text="Presets"/></StackPanel></RadioButton>
          <RadioButton x:Name="RecoveryNav" Style="{StaticResource NavButton}" Tag="3" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" Width="29" VerticalAlignment="Center"/><TextBlock Text="Recovery"/></StackPanel></RadioButton>
          <RadioButton x:Name="AppearanceNav" Style="{StaticResource NavButton}" Tag="6" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" Width="29" VerticalAlignment="Center"/><TextBlock Text="Appearance"/></StackPanel></RadioButton>
          <RadioButton x:Name="SettingsNav" Style="{StaticResource NavButton}" Tag="4" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Width="29" VerticalAlignment="Center"/><TextBlock Text="About &amp; settings"/></StackPanel></RadioButton>
          <RadioButton x:Name="UpdatesNav" Style="{StaticResource NavButton}" Tag="5" Checked="Navigate"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" Width="29" VerticalAlignment="Center"/><TextBlock Text="Updates"/></StackPanel></RadioButton>
        </StackPanel>
        <ScrollViewer Grid.Row="2" Visibility="{Binding HasSettingsSearch, Converter={StaticResource BoolVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource Muted}" Margin="12,0,0,8"/>
            <TextBlock Text="No settings found." Style="{StaticResource Muted}" Margin="12,8" Visibility="{Binding NoSettingsSearchResults, Converter={StaticResource BoolVisibility}}"/>
            <ItemsControl ItemsSource="{Binding SettingsSearchResults}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Button Click="SettingsSearchResultClick" Tag="{Binding}" HorizontalContentAlignment="Stretch" Padding="10,10" Margin="0,0,0,4" Background="{DynamicResource SurfaceBrush}" BorderThickness="0">
                  <StackPanel><TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                </Button>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Text="{Binding AppVersion, StringFormat=Version {0}}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="12,16,0,0"/>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TabControl x:Name="Pages" SelectedIndex="{Binding Page}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" Padding="0" IsEnabled="{Binding IsIdle}">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,25,28,28">
            <TextBlock Text="Overview" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Manage Roblox performance and choose the client to launch." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            <TextBlock Text="Performance" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0"><TextBlock Text="Custom frame rate" Style="{StaticResource SettingLabel}"/><TextBlock Text="Use a custom cap for Roblox Player's next start." Style="{StaticResource SettingDescription}"/><TextBlock Text="{Binding FpsStatus}" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Retry" Click="RetryFpsClick" Margin="0,0,14,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding FpsChangePending}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding UnlockFps, Mode=OneWay}" Click="UnlockFpsClick" AutomationProperties.Name="Use a custom FPS cap"/>
              </StackPanel>
            </Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="FPS limit" Style="{StaticResource SettingLabel}"/><TextBlock Text="1 to 9,999. Takes effect on Player's next start." Style="{StaticResource SettingDescription}"/>
                <TextBlock Text="{Binding FpsCapValidation}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding HasFpsCapError, Converter={StaticResource BoolVisibility}}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBox Text="{Binding FpsCapText, UpdateSourceTrigger=PropertyChanged}" Width="72" MaxLength="4" VerticalContentAlignment="Center" AutomationProperties.Name="FPS limit"/><Button Content="Set limit" Click="SaveFpsCapClick" Margin="8,0,0,0"/></StackPanel>
            </Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,4,0,0"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center"><TextBlock Text="Graphics quality" Style="{StaticResource SettingLabel}"/><TextBlock Text="Choose Automatic or a manual level from 1 to 10." Style="{StaticResource SettingDescription}"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox ItemsSource="{Binding GraphicsQualityOptions}" SelectedItem="{Binding SelectedGraphicsQuality}" DisplayMemberPath="Label" Width="150" AutomationProperties.Name="Graphics quality"/><Button Content="Apply" Click="ApplyGraphicsQualityClick" Margin="8,0,0,0"/></StackPanel>
              </Grid>
              <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding GraphicsQualityStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Retry" Click="RetryGraphicsQualityClick" Margin="0,0,8,0" Visibility="{Binding GraphicsQualityChangePending, Converter={StaticResource BoolVisibility}}"/><Button Content="Restore previous" Click="RestoreGraphicsQualityClick"/></StackPanel>
              </Grid>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0"><TextBlock Text="Close N strap after launch" Style="{StaticResource SettingLabel}"/><TextBlock Text="Exit N strap once Roblox has started." Style="{StaticResource SettingDescription}"/></StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding CloseAfterLaunch}" AutomationProperties.Name="Close N strap after launching Roblox"/>
            </Grid></Border>
            <TextBlock Text="Profile" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock Text="Selected profile" Style="{StaticResource SettingLabel}"/><TextBlock Text="{Binding FlagSummary}" Style="{StaticResource SettingDescription}"/></StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" VerticalAlignment="Center" AutomationProperties.Name="Selected profile"/>
            </Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock Text="FastFlags" Style="{StaticResource SettingLabel}"/><TextBlock Text="Edit the flags saved in this profile." Style="{StaticResource SettingDescription}"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Manage" Click="GoFlags" Margin="0,0,8,0"/><Button Content="Apply profile" Click="ApplyClick"/></StackPanel>
            </Grid></Border>
            <TextBlock Text="Installation" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Roblox client" Style="{StaticResource SettingLabel}"/><TextBlock Text="{Binding InstallationSummary}" Style="{StaticResource SettingDescription}"/></StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedInstallation}" DisplayMemberPath="DisplayName" ToolTip="{Binding ClientPath}" VerticalAlignment="Center" AutomationProperties.Name="Roblox installation"/>
              </Grid>
              <TextBlock Text="{Binding ClientPath}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ClientPath}" Margin="0,12,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Find an installation" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0,0,14,0"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Refresh" Click="RefreshClick" Margin="0,0,8,0"/><Button Content="Choose folder" Click="ChooseFolderClick"/></StackPanel>
            </Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="Install Roblox" Style="{StaticResource SettingLabel}"/><TextBlock Text="Download from Roblox's official servers." Style="{StaticResource SettingDescription}"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Get Studio" Click="GetStudioClick" Margin="0,0,8,0"/><Button Content="Install / update Player" Click="InstallClick"/></StackPanel>
            </Grid></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem>
          <Grid Margin="28,25,28,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="FastFlags" Style="{StaticResource PageTitle}"/><TextBlock Text="Edit your profile, then apply it to the selected client." Style="{StaticResource Muted}" Margin="0,6,12,0"/></StackPanel>
              <Button Grid.Column="1" Content="Apply profile" Click="ApplyClick" VerticalAlignment="Top"/>
            </Grid>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,20,0,12">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="145"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" VerticalAlignment="Center" AutomationProperties.Name="FastFlags profile"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0"><Button Content="New" Click="NewProfileClick" Margin="0,0,4,0"/><Button Content="Duplicate" Click="DuplicateProfileClick" Margin="0,0,4,0"/><Button Content="Rename" Click="RenameProfileClick" Margin="0,0,4,0"/><Button Content="Delete" Style="{StaticResource Quiet}" Click="DeleteProfileClick"/></StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Margin="0,0,0,10"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search flags by name" AutomationProperties.Name="Search flags" Padding="10,7,32,7"/>
                <TextBlock Text="Search flags" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}" Margin="11,0,0,0" FontSize="12" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" IsHitTestVisible="False"/>
              </Grid>
              <WrapPanel Grid.Row="1"><Button Content="Add flag" Click="AddFlagClick" Margin="0,0,6,0"/><Button x:Name="ImportButton" Content="Import file" Click="ImportClick" ToolTip="Import a .txt or .json file and apply it to the selected client" Margin="0,0,6,0"/><Button Content="JSON editor" Click="JsonClick" Margin="0,0,6,0"/><Button Content="Remove" Click="RemoveFlagClick"/></WrapPanel>
            </Grid>
            <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}">
              <Grid>
                <DataGrid x:Name="FlagsGrid" ItemsSource="{Binding FlagsView}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource TableLineBrush}"
                          RowHeaderWidth="0" HeadersVisibility="Column" RowHeight="40" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                  <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource HeaderBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="10,10"/><Setter Property="BorderThickness" Value="0"/></Style>
                    <Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource RowSelectedBrush}"/></Trigger></Style.Triggers></Style>
                    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="7,7"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/></Style>
                  </DataGrid.Resources>
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="On" Width="46"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="7,0,0,0" AutomationProperties.Name="Flag enabled"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Flag name" Width="*" MinWidth="280"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Name}" AutomationProperties.Name="Flag name"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Value" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding TypeHint}" AutomationProperties.Name="Flag value"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Support" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Support}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Support}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding EmptyFlags, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False" Margin="20"><TextBlock Text="No flags in this profile" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,6"/><TextBlock Text="Add a flag, import JSON, or choose a preset." Style="{StaticResource Muted}" TextAlignment="Center"/></StackPanel>
              </Grid>
            </Border>
            <StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock Text="Drop a .txt or .json file to import and apply." Style="{StaticResource Muted}"/><TextBlock Text="Support labels follow Roblox Player's published allowlist. Studio has no local allowlist. Roblox determines which flags take effect." Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
          </Grid>
        </TabItem>
        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,25,28,28">
            <TextBlock Text="Presets" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Tune visual detail and rendering for your hardware. Changes save to the selected profile." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            <Grid Margin="0,18,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Profile" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" MaxWidth="300" HorizontalAlignment="Left" MinWidth="180" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Preset profile"/>
              <Button Grid.Column="2" Content="Review FastFlags" Click="GoFlags"/>
            </Grid>
            <TextBlock Text="Apply from FastFlags, or launch with Apply before launch enabled. Restart Roblox to load changes." Style="{StaticResource Muted}" Margin="0,0,0,16"/>
            <StackPanel IsEnabled="{Binding IsIdle}">
              <Border Style="{StaticResource Card}"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                  <TextBlock Text="Low detail" Style="{StaticResource SettingLabel}"/>
                  <TextBlock Text="Low mesh detail, lighter textures, no terrain grass and no MSAA." Style="{StaticResource SettingDescription}"/>
                  <TextBlock Text="May reduce rendering work at the cost of detail. Results vary by experience and hardware." Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Use low detail" Tag="{Binding LowDetailPreset}" Click="PresetClick" VerticalAlignment="Center"/>
              </Grid></Border>

              <TextBlock Text="Geometry" Style="{StaticResource SectionTitle}"/>
              <Border Style="{StaticResource Card}"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0"><TextBlock Text="Mesh detail" Style="{StaticResource SettingLabel}"/><TextBlock Text="Choose detail thresholds for supported geometry. Lower presets can simplify distant shapes." Style="{StaticResource SettingDescription}"/></StackPanel>
                <ComboBox x:Name="MeshDetailCombo" Grid.Column="1" ItemsSource="{Binding MeshDetail.Choices}" Tag="{Binding MeshDetail}" DisplayMemberPath="Label" ItemContainerStyle="{StaticResource PresetChoiceItem}" SelectionChanged="PresetSelectionChanged" VerticalAlignment="Center" AutomationProperties.Name="Mesh detail"/>
              </Grid></Border>
              <Border Style="{StaticResource Card}" Margin="0,4,0,0"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0"><TextBlock Text="Terrain grass" Style="{StaticResource SettingLabel}"/><TextBlock Text="Turn off terrain grass drawing where supported. Does not remove grass built from other objects." Style="{StaticResource SettingDescription}"/></StackPanel>
                <ComboBox x:Name="GrassCombo" Grid.Column="1" ItemsSource="{Binding Grass.Choices}" Tag="{Binding Grass}" DisplayMemberPath="Label" ItemContainerStyle="{StaticResource PresetChoiceItem}" SelectionChanged="PresetSelectionChanged" VerticalAlignment="Center" AutomationProperties.Name="Terrain grass"/>
              </Grid></Border>

              <TextBlock Text="Rendering &amp; graphics" Style="{StaticResource SectionTitle}"/>
              <Border Style="{StaticResource Card}"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0"><TextBlock Text="Anti-aliasing (MSAA)" Style="{StaticResource SettingLabel}"/><TextBlock Text="Smooths jagged edges. More samples can increase GPU work; Off uses one sample." Style="{StaticResource SettingDescription}"/></StackPanel>
                <ComboBox x:Name="MsaaCombo" Grid.Column="1" ItemsSource="{Binding Msaa.Choices}" Tag="{Binding Msaa}" DisplayMemberPath="Label" ItemContainerStyle="{StaticResource PresetChoiceItem}" SelectionChanged="PresetSelectionChanged" VerticalAlignment="Center" AutomationProperties.Name="Anti-aliasing MSAA"/>
              </Grid></Border>
              <Border Style="{StaticResource Card}" Margin="0,4,0,0"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0"><TextBlock Text="Texture quality" Style="{StaticResource SettingLabel}"/><TextBlock Text="Lower quality can reduce texture memory use. Higher quality keeps more texture detail." Style="{StaticResource SettingDescription}"/></StackPanel>
                <ComboBox x:Name="TextureQualityCombo" Grid.Column="1" ItemsSource="{Binding TextureQuality.Choices}" Tag="{Binding TextureQuality}" DisplayMemberPath="Label" ItemContainerStyle="{StaticResource PresetChoiceItem}" SelectionChanged="PresetSelectionChanged" VerticalAlignment="Center" AutomationProperties.Name="Texture quality"/>
              </Grid></Border>
              <Border Style="{StaticResource Card}" Margin="0,4,0,0"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                  <TextBlock Text="Preserve quality on high DPI" Style="{StaticResource SettingLabel}"/>
                  <TextBlock Text="Request native resolution instead of Roblox's DPI scaling. Sharper on scaled displays, but can increase GPU work." Style="{StaticResource SettingDescription}"/>
                  <TextBlock x:Name="CustomDpiNotice" Text="Custom value kept. Click the switch to return to Automatic." Style="{StaticResource Muted}" Margin="0,7,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <CheckBox x:Name="NativeDpiToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsThreeState="False" Click="NativeDpiClick" ToolTip="Off removes the DPI override from this profile." AutomationProperties.Name="Preserve quality on high DPI"/>
              </Grid></Border>
              <Border Style="{StaticResource Card}" Margin="0,4,0,0"><StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Rendering quality override" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="Request a rendering quality level (FRM). Lower levels reduce detail and may reduce GPU work." Style="{StaticResource SettingDescription}"/>
                    <TextBlock x:Name="CustomRenderingQualityNotice" Text="Custom value kept. Choose a level, or click the switch to return to Automatic." Style="{StaticResource Muted}" Margin="0,7,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                  <CheckBox x:Name="RenderingQualityToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsThreeState="False" Click="RenderingQualityClick" ToolTip="On starts at level 1. Off removes the FRM override from this profile." AutomationProperties.Name="Rendering quality override"/>
                </Grid>
                <Grid x:Name="RenderingQualityOptions" Margin="0,14,0,0" Visibility="Collapsed">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Level 1 is lowest; 21 is highest. Uses a separate scale from the in-game slider." Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                  <ComboBox x:Name="RenderingQualityCombo" Grid.Column="1" ItemsSource="{Binding RenderingQualityLevels}" Tag="{Binding RenderingQuality}" DisplayMemberPath="Label" ItemContainerStyle="{StaticResource PresetChoiceItem}" SelectionChanged="PresetSelectionChanged" AutomationProperties.Name="Rendering quality level"/>
                </Grid>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,4,0,0"><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0"><TextBlock Text="Rendering mode" Style="{StaticResource SettingLabel}"/><TextBlock Text="Request a graphics backend. Automatic lets Roblox choose; performance and compatibility depend on your hardware." Style="{StaticResource SettingDescription}"/></StackPanel>
                <ComboBox x:Name="RendererCombo" Grid.Column="1" ItemsSource="{Binding Renderer.Choices}" Tag="{Binding Renderer}" DisplayMemberPath="Label" ItemContainerStyle="{StaticResource PresetChoiceItem}" SelectionChanged="PresetSelectionChanged" VerticalAlignment="Center" AutomationProperties.Name="Rendering mode"/>
              </Grid></Border>
              <TextBlock Text="Automatic removes only that setting's flags. Custom means the profile contains a different, partial or disabled value; it stays unchanged until you choose an option." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
              <Expander Header="Quick presets" Style="{StaticResource PresetExpander}" Margin="0,24,0,0" IsExpanded="False">
                <ItemsControl ItemsSource="{Binding Presets}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border Style="{StaticResource Card}" Margin="0,0,0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0"><TextBlock Text="{Binding Category}" Style="{StaticResource Eyebrow}"/><TextBlock Text="{Binding Name}" FontSize="16" Margin="0,4,0,6" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Caveat}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
                    <Button Grid.Column="1" Content="Add to profile" Click="PresetClick" VerticalAlignment="Center" Tag="{Binding}"/>
                  </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </Expander>
            </StackPanel>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,25,28,28">
            <TextBlock Text="Recovery" Style="{StaticResource PageTitle}"/><TextBlock Text="Restore settings managed by N strap or find a previous backup." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            <TextBlock Text="Restore settings" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><TextBlock Text="Roblox client" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Margin="0,0,16,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedInstallation}" DisplayMemberPath="DisplayName" AutomationProperties.Name="Installation to restore"/></Grid>
              <TextBlock Text="{Binding ClientPath}" Style="{StaticResource Muted}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ClientPath}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0"><TextBlock Text="Restore managed settings" Style="{StaticResource SettingLabel}"/><TextBlock Text="Remove applied flags and return their previous values. Unmanaged settings are preserved." Style="{StaticResource SettingDescription}"/></StackPanel><Button Grid.Column="1" Content="Restore" Click="RestoreClick" VerticalAlignment="Center"/>
            </Grid></Border>
            <TextBlock Text="Restore stops if a managed value changed after the latest apply. When applying again, externally changed flags still in the profile get a new restore value; removed flags keep those external changes." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
            <TextBlock Text="Backups" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="Settings backups" Style="{StaticResource SettingLabel}"/><TextBlock Text="A dated copy is saved before each change to an existing settings file." Style="{StaticResource SettingDescription}"/></StackPanel><Button Grid.Column="1" Content="Open folder" Click="BackupsClick" VerticalAlignment="Center"/></Grid></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,25,28,28">
            <TextBlock Text="About &amp; settings" Style="{StaticResource PageTitle}"/><TextBlock Text="Manage N strap's launch behavior and local data." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            <TextBlock Text="Launch behavior" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0"><TextBlock Text="Apply profile before launching" Style="{StaticResource SettingLabel}"/><TextBlock Text="Apply the selected profile whenever you launch Roblox from N strap." Style="{StaticResource SettingDescription}"/></StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ApplyBeforeLaunch}" AutomationProperties.Name="Apply the selected profile before launching"/>
            </Grid></Border>
            <TextBlock Text="Launch closes running Roblox Player sessions first. Studio stays open. After a Roblox update, refresh installations to select the new version." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
            <TextBlock Text="Local data" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0"><TextBlock Text="Data folder" Style="{StaticResource SettingLabel}"/><TextBlock Text="{Binding DataDirectory}" Style="{StaticResource SettingDescription}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding DataDirectory}"/></StackPanel>
              <Button Grid.Column="1" Content="Open folder" Click="DataFolderClick" VerticalAlignment="Center"/>
            </Grid></Border>
            <Border Style="{StaticResource Card}" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0"><TextBlock Text="Clear old Roblox cache" Style="{StaticResource SettingLabel}"/><TextBlock Text="Remove cached files older than 14 days. Close Player and Studio first; Roblox may need to download these files again." Style="{StaticResource SettingDescription}"/><TextBlock Text="{Binding CacheStatus}" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
              <Button Grid.Column="1" Content="Clear cache" Click="CleanCacheClick" VerticalAlignment="Center"/>
            </Grid></Border>
            <TextBlock Text="About" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding AppVersion, StringFormat=N strap {0}}" FontSize="16"/><TextBlock Text="Created by lukeistaken" Style="{StaticResource SettingDescription}"/></StackPanel>
                <Button Grid.Column="1" Content="Copy username" Click="CopyDiscordClick" ToolTip="Copy the Discord username lukeistaken" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="N strap is not affiliated with Roblox Corporation." Style="{StaticResource Muted}" Margin="0,14,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,4,0,0"><StackPanel><WrapPanel><Button Content="Flag documentation" Click="DocsClick" Margin="0,0,8,4"/><Button Content="Roblox support" Click="SupportClick" Margin="0,0,0,4"/></WrapPanel><TextBlock Text="{Binding CatalogDate, StringFormat=Support catalog checked {0}}" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Border>
            <Grid Margin="0,24,0,12">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Licenses" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Content="View notices" Click="ViewNoticesClick" ToolTip="Read the full licenses and third-party notices"/>
            </Grid>
            <WrapPanel>
              <Button Style="{StaticResource LicenseCard}" Click="NstrapRepositoryClick" ToolTip="Open N strap license on GitHub" AutomationProperties.Name="N strap, MIT License. Open license on GitHub">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,14,0"><TextBlock Text="N strap" FontSize="14"/><TextBlock Text="MIT License" Style="{StaticResource SettingDescription}"/></StackPanel>
                  <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Style="{StaticResource LicenseCard}" Click="DotNetRepositoryClick" ToolTip="Open .NET Runtime on GitHub" AutomationProperties.Name=".NET Runtime, MIT License. Open GitHub repository">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,14,0"><TextBlock Text=".NET Runtime" FontSize="14"/><TextBlock Text="MIT License" Style="{StaticResource SettingDescription}"/></StackPanel>
                  <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Style="{StaticResource LicenseCard}" Click="WpfRepositoryClick" ToolTip="Open WPF on GitHub" AutomationProperties.Name="WPF, MIT License. Open GitHub repository">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,14,0"><TextBlock Text="WPF" FontSize="14"/><TextBlock Text="MIT License" Style="{StaticResource SettingDescription}"/></StackPanel>
                  <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </WrapPanel>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,25,28,28">
            <TextBlock Text="Updates" Style="{StaticResource PageTitle}"/><TextBlock Text="Check for a new version of N strap." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            <TextBlock Text="N strap" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0"><TextBlock Text="{Binding AppVersion, StringFormat=Installed version: {0}}" Style="{StaticResource SettingLabel}"/><TextBlock Text="{Binding AvailableUpdate, StringFormat=Latest release: {0}}" Style="{StaticResource SettingDescription}"/></StackPanel>
                <Button Grid.Column="1" Content="Check for updates" Click="CheckUpdateClick" VerticalAlignment="Center"/>
              </Grid>
              <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" Margin="0,14,0,0"/>
              <WrapPanel Margin="0,12,0,0"><Button Content="Install and restart" Click="InstallUpdateClick" Style="{StaticResource Primary}" Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,0"/><Button Content="Open releases" Click="OpenReleasesClick"/></WrapPanel>
            </StackPanel></Border>
            <TextBlock Text="Preferences" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0"><TextBlock Text="Update automatically" Style="{StaticResource SettingLabel}"/><TextBlock Text="Check on startup. Download and restart when a newer release is available." Style="{StaticResource SettingDescription}"/></StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoUpdate, Mode=OneWay}" Click="AutoUpdateClick" AutomationProperties.Name="Automatically update when N strap starts"/>
            </Grid></Border>
            <TextBlock Text="Updates come from N strap's GitHub releases." Style="{StaticResource Muted}" Margin="0,12,0,0"/>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,25,28,28">
            <TextBlock Text="Appearance" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Choose a theme, name and icon." Style="{StaticResource Muted}" Margin="0,6,0,0"/>
            <TextBlock Text="Theme" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,20,0">
                <TextBlock Text="Color theme" Style="{StaticResource SettingLabel}"/>
                <TextBlock Text="Applies to the app and its dialogs." Style="{StaticResource SettingDescription}"/>
              </StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=OneWay}" SelectionChanged="ThemeSelectionChanged" VerticalAlignment="Center" AutomationProperties.Name="Color theme"/>
            </Grid></Border>
            <TextBlock Text="Changes apply instantly and are saved automatically." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
            <TextBlock Text="Program" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Display name" Style="{StaticResource SettingLabel}"/>
              <TextBlock Text="The name shown in the window title and sidebar." Style="{StaticResource SettingDescription}"/>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding DisplayNameDraft, UpdateSourceTrigger=PropertyChanged}" MaxLength="48" Margin="0,0,10,0" AutomationProperties.Name="Program display name"/>
                <Button Grid.Column="1" Content="Save name" Click="SaveDisplayNameClick" IsEnabled="{Binding CanSaveDisplayName}"/>
              </Grid>
              <TextBlock Text="{Binding DisplayNameValidation}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DisplayNameValidation}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,4,0,0"><StackPanel>
              <TextBlock Text="Executable and process name" Style="{StaticResource SettingLabel}"/>
              <TextBlock Text="{Binding CurrentExecutableName, StringFormat=Currently running as {0}}" Style="{StaticResource SettingDescription}"/>
              <TextBlock Text="Changes the .exe filename and Task Manager's Details image name. The Windows file description remains N strap. Restarts the app and removes the old executable after success; update shortcuts to the old filename." Style="{StaticResource SettingDescription}"/>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox Text="{Binding ProcessNameDraft, UpdateSourceTrigger=PropertyChanged}" MaxLength="68" Margin="0,0,10,0" AutomationProperties.Name="Executable and process name" ToolTip="A filename without a path. The .exe extension is added automatically."/>
                <Button Grid.Column="1" Content="Rename and restart" Click="RenameProcessClick" IsEnabled="{Binding CanRenameProcess}"/>
              </Grid>
              <TextBlock Text="{Binding ProcessNameValidation}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding ProcessNameValidation}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,4,0,0"><Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="48" Height="48" CornerRadius="6" Background="{DynamicResource RaisedBrush}" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Image Source="{DynamicResource AppIcon}" Margin="6" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Current program icon"/>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Custom icon" Style="{StaticResource SettingLabel}"/>
                <TextBlock Text="{Binding IconStatus}" Style="{StaticResource SettingDescription}"/>
                <WrapPanel Margin="0,12,0,0">
                  <Button Content="Choose icon…" Click="PickIconClick" Margin="0,0,8,0"/>
                  <Button Content="Reset to original" Click="ResetIconClick" IsEnabled="{Binding HasCustomIcon}"/>
                </WrapPanel>
                <TextBlock Text="PNG or ICO, up to 4 MB. A copy is kept with your settings. The executable's icon in File Explorer stays unchanged." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
              </StackPanel>
            </Grid></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
      <Border Grid.Row="1" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource FooterLineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
        <StackPanel>
          <StackPanel Margin="0,0,0,10"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock Text="{Binding StatusDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="48" ToolTip="{Binding StatusDetail}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding StatusDetail}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
          </StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding FlagCounter}" FontSize="12"/><TextBlock Text="Drafts save automatically" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel>
            <Button Grid.Column="1" Content="Launch Roblox" Style="{StaticResource Primary}" Click="LaunchClick" IsEnabled="{Binding IsIdle}" MinWidth="128" ToolTip="Closes running Roblox Player sessions before launching" VerticalAlignment="Center"/>
          </Grid>
          <ProgressBar Style="{StaticResource BusyProgress}" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Height="2" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
    <Border x:Name="DropCue" Grid.ColumnSpan="2" Panel.ZIndex="20" Visibility="Collapsed" IsHitTestVisible="False" Margin="10" Background="{DynamicResource OverlayBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="4">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"><TextBlock Text="Drop to import and apply" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{Binding SelectedProfileName, StringFormat=Merge into profile: {0}}" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0"/></StackPanel>
    </Border>
  </Grid>
</Window>
