<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:local="clr-namespace:Nstrap.App">
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="42"/>
    <Setter Property="Height" Value="{x:Static local:WindowFrame.CaptionHeight}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value=".4"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#C42B1C"/>
        <Setter Property="Foreground" Value="White"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="#A52418"/>
        <Setter Property="Foreground" Value="White"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="AppWindowFrame" TargetType="Window">
    <!-- Keep the normal HWND style: WindowChrome replaces its visuals while
         Windows retains moving, sizing, taskbar bounds and keyboard commands. -->
    <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Window">
          <!-- WindowChrome owns the root margin. Keep work-area insets inside it. -->
          <Grid Background="{TemplateBinding Background}">
            <Border Padding="{Binding Path=(local:WindowFrame.MaximizedPadding), RelativeSource={RelativeSource TemplatedParent}}">
              <Border x:Name="Frame" Background="{TemplateBinding Background}"
                      BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Grid Height="{x:Static local:WindowFrame.CaptionHeight}" Background="{DynamicResource CanvasBrush}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="CaptionIcon" Source="{TemplateBinding Icon}" Width="16" Height="16"
                           Margin="12,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="CaptionTitle" Grid.Column="1" Text="{TemplateBinding Title}"
                               FontSize="12" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                      <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                              Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                              ToolTip="Minimize" AutomationProperties.Name="Minimize window">
                        <Path Data="M 0,5 L 10,5" Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                      </Button>
                      <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                              Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                              ToolTip="Maximize" AutomationProperties.Name="Maximize window">
                        <Path Data="M .5,.5 L 9.5,.5 9.5,9.5 .5,9.5 Z" Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                      </Button>
                      <Button x:Name="RestoreButton" Style="{StaticResource CaptionButton}" Visibility="Collapsed"
                              Command="{x:Static SystemCommands.RestoreWindowCommand}"
                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                              ToolTip="Restore" AutomationProperties.Name="Restore window">
                        <Path Data="M 2.5,2.5 L 2.5,.5 9.5,.5 9.5,7.5 7.5,7.5 M .5,2.5 L 7.5,2.5 7.5,9.5 .5,9.5 Z" Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                      </Button>
                      <Button Style="{StaticResource CloseCaptionButton}"
                              Command="{x:Static SystemCommands.CloseWindowCommand}"
                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                              ToolTip="Close" AutomationProperties.Name="Close window">
                        <Path Data="M .5,.5 L 9.5,9.5 M 9.5,.5 L .5,9.5" Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <AdornerDecorator Grid.Row="1">
                    <ContentPresenter ContentSource="Content"/>
                  </AdornerDecorator>
                </Grid>
              </Border>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsActive" Value="False">
              <Setter TargetName="CaptionTitle" Property="Foreground" Value="{DynamicResource MutedBrush}"/>
              <Setter TargetName="CaptionIcon" Property="Opacity" Value=".65"/>
            </Trigger>
            <Trigger Property="WindowState" Value="Maximized">
              <Setter TargetName="Frame" Property="BorderThickness" Value="0"/>
              <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="RestoreButton" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="ResizeMode" Value="CanMinimize">
              <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="RestoreButton" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="ResizeMode" Value="NoResize">
              <Setter TargetName="MinimizeButton" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="RestoreButton" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
